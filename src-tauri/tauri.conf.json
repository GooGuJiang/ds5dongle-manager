{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS5 Dongle Manager",
  "version": "0.1.8",
  "identifier": "com.ds5donglemanager.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DS5 Dongle Manager",
        "width": 1400,
        "height": 800,
        "minWidth": 1400,
        "minHeight": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A desktop manager for DS5Dongle, providing a modern UI to configure and manage Pico2W DualSense bridge devices.",
    "longDescription": "A desktop manager for DS5Dongle, providing a modern UI to configure and manage Pico2W DualSense bridge devices.",
    "icon": [
      "icons/pwa-icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/sounds/controller-connected.wav",
      "resources/sounds/controller-disconnected.wav",
      "resources/sounds/controller-low-battery.wav"
    ]
  }
}
