{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS5 Dongle Manager",
  "version": "0.1.0",
  "identifier": "com.ds5donglemanager.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DS5 Dongle Manager",
        "width": 1400,
        "height": 800,
        "minWidth": 1400,
        "minHeight": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/pwa-icon.png"
    ]
  }
}
